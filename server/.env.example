# ════════════════════════════════════════════════════════════════════════
# Connect Server — Environment Configuration
# ════════════════════════════════════════════════════════════════════════
# Copy this file to .env and modify values as needed.
# All values shown are production-safe defaults.
# ════════════════════════════════════════════════════════════════════════

# ─── SERVER ──────────────────────────────────────────────────────────────
# Port range the server will scan for an available port.
# If PORT_START is busy, it tries PORT_START+1, etc. up to PORT_END.
PORT_START=3000
PORT_END=3010

# Bind address. Use 0.0.0.0 to accept connections from all network interfaces.
# Use 127.0.0.1 to restrict to localhost only (development).
BIND_ADDRESS=0.0.0.0

# ─── LIMITS ──────────────────────────────────────────────────────────────
# Maximum simultaneous WebSocket connections the server will accept.
MAX_CONNECTIONS=200

# Maximum number of chat rooms allowed at one time.
MAX_ROOMS=100

# Maximum members allowed in a single room.
MAX_ROOM_MEMBERS=100

# Maximum length of a single text message (characters).
MAX_MESSAGE_LENGTH=5000

# Maximum file size for file transfers (bytes). Default: 50MB.
MAX_FILE_SIZE=52428800

# Number of recent messages stored per room on the server.
# Older messages are pruned automatically.
MESSAGE_HISTORY_LIMIT=100

# ─── RATE LIMITING ───────────────────────────────────────────────────────
# Maximum WebSocket messages a single client can send within the window.
RATE_LIMIT_MAX=60

# Time window for rate limiting (milliseconds). Default: 60 seconds.
RATE_LIMIT_WINDOW=60000

# ─── HEARTBEAT ───────────────────────────────────────────────────────────
# Interval between server ping frames to detect dead connections (ms).
PING_INTERVAL=25000

# Time to wait for a pong response before terminating the connection (ms).
PONG_TIMEOUT=10000

# ─── ROOM MANAGEMENT ────────────────────────────────────────────────────
# How often the server scans for stale/empty rooms to clean up (ms).
# Default: 5 minutes.
ROOM_CLEANUP_INTERVAL=300000

# How long an empty room is kept before automatic deletion (ms).
# Default: 1 hour.
ROOM_EMPTY_TIMEOUT=3600000

# ─── PERSISTENCE ─────────────────────────────────────────────────────────
# Directory for persistent data (rooms.json, server state).
# Relative to server/ directory.
DATA_DIR=data

# Auto-save interval for room state to disk (ms). Default: 30 seconds.
AUTO_SAVE_INTERVAL=30000

# ─── LOGGING ─────────────────────────────────────────────────────────────
# Log level: ERROR, WARN, INFO, DEBUG.
# ERROR  — Critical failures only.
# WARN   — Warnings + errors.
# INFO   — General operations + warnings + errors (recommended for production).
# DEBUG  — Verbose output including message payloads (development only).
LOG_LEVEL=INFO

# Maximum log file size before rotation (bytes). Default: 10MB.
# When exceeded, current log is renamed to server.log.old and a new file starts.
LOG_MAX_SIZE=10485760

# ─── SECURITY ────────────────────────────────────────────────────────────
# Optional admin token for accessing /api/admin/* endpoints.
# Leave empty to disable admin API authentication.
ADMIN_TOKEN=

# Enable or disable CORS headers. Set to false if behind a reverse proxy
# that already handles CORS.
CORS_ENABLED=true

# ─── ENVIRONMENT ─────────────────────────────────────────────────────────
# Set to "production" to disable verbose error responses and enable
# performance optimizations.
NODE_ENV=production