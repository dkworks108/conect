{
  "name": "connect-server",
  "version": "2.0.0",
  "description": "Production WebSocket server for Connect PWA - Local mesh network communication.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "prod": "NODE_ENV=production node server.js",
    "test": "node --test ../tests/server.test.js",
    "logs": "tail -f data/logs/server.log | node -e \"process.stdin.on('data',d=>d.toString().split('\\n').filter(Boolean).forEach(l=>{try{const e=JSON.parse(l);console.log(e.timestamp,e.level,e.component,e.message,JSON.stringify(e.data))}catch{console.log(l)}}))\""
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "express": "4.18.2",
    "qrcode-terminal": "0.12.0",
    "ws": "8.16.0"
  },
  "author": "Connect Team",
  "license": "MIT"
}
